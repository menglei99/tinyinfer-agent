+#include "tinyinfer/softmax.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace tinyinfer {
+
+bool softmax_fp32(const float* x, float* y, std::size_t n) {
+    if (x == nullptr || y == nullptr || n == 0) return false;
+    float m = x[0];
+    for (std::size_t i = 1; i < n; ++i) m = std::max(m, x[i]);
+    float s = 0.0f;
+    for (std::size_t i = 0; i < n; ++i) {
+        y[i] = std::exp(x[i] - m);
+        s += y[i];
+    }
+    for (std::size_t i = 0; i < n; ++i) y[i] /= s;
+    return true;
+}
+
+}  // namespace tinyinfer
