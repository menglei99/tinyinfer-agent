{
  "_comment": "把这一段加到你的 claude_desktop_config.json 的 mcpServers 下。把 REPO_DIR 替换成本仓库 clone 的绝对路径（Windows 上比如 D:/tinyinfer-agent，macOS 上比如 /Users/you/tinyinfer-agent）。",
  "mcpServers": {
    "tinyinfer-toolchain": {
      "command": "REPO_DIR/.venv/Scripts/python.exe",
      "args": ["-m", "agent.mcp.server"],
      "env": {
        "TINYINFER_PROJECT_DIR": "REPO_DIR/tinyinfer",
        "TINYINFER_BUILD_DIR": "REPO_DIR/tinyinfer/build"
      }
    }
  }
}
