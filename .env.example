# 选一个 provider。值留空就回退到 mock LLM。

# DeepSeek（OpenAI 兼容，性价比好）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic（需要 `pip install -e ".[anthropic]"`）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 智谱 GLM（OpenAI 兼容）
# 常用模型：glm-4-plus（最强）、glm-4-air、glm-4-flash、glm-4
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# 阿里云 DashScope（Qwen，OpenAI 兼容）
# 各区域 base_url：
#   华北2（北京）：     https://dashscope.aliyuncs.com/compatible-mode/v1
#   美西（弗吉尼亚）：   https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   新加坡：            https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 常用模型：qwen-plus、qwen-max、qwen-turbo、qwen3.6-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 当前激活的 provider：deepseek | openai | anthropic | glm | qwen | mock
LLM_PROVIDER=mock

# Trace
TRACE_DIR=traces

# ---------- RAG ----------

# 向量库后端：numpy | chroma（默认）| qdrant | milvus
# - chroma 是嵌入式 sqlite，不需要 daemon
# - qdrant 默认走 local 模式；设置 QDRANT_URL 就连远端 server
# - milvus 需要 [rag-milvus] extra
VECTOR_STORE_BACKEND=chroma
CHROMA_PATH=.chroma_db
QDRANT_PATH=.qdrant_db
# QDRANT_URL=http://localhost:6333
# MILVUS_LITE_PATH=.milvus_lite.db

# Embedding provider：mock（默认）| dashscope（复用上面的 DASHSCOPE_API_KEY）
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-v4

# ---------- Self-consistency ----------
# 0 = 关（每个 shape plan 一次 LLM 调用）。>= 2 = N 路抽样 + 多数投票。
SELF_CONSISTENCY_N=0

# ---------- Reflexion ----------
# on（默认）= critic FAIL 时把 missing dims 当 lesson 喂回下一轮生成器
# off = 关掉这个反馈环
REFLEXION=on

# ---------- LangSmith（可选）----------
# 这三个一设上，LangGraph 就自动 trace —— 不用改一行代码。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tinyinfer-agent

# ---------- Docker builder（没有本机 C++ 编译器时用）----------
# 设上下面这一对，cmake/ctest 会跑在容器里而不是宿主直接调（详见 docs/DOCKER_BUILDER.md）。
# 镜像构建：docker build -t tinyinfer-builder docker/builder/
# TINYINFER_DOCKER_IMAGE=tinyinfer-builder
# 容器内 build 目录（避免与宿主 MSVC build 混合）
# TINYINFER_BUILD_DIR=tinyinfer/build-docker
