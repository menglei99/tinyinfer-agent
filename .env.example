# Choose ONE provider. Empty values fall back to mock LLM.

# DeepSeek (OpenAI-compatible, recommended for cost)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (requires `pip install -e ".[anthropic]"`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Zhipu GLM (OpenAI-compatible)
# Common models: glm-4-plus (most capable), glm-4-air, glm-4-flash, glm-4
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# Aliyun DashScope (Qwen, OpenAI-compatible)
# Region base_urls:
#   华北2 (Beijing):     https://dashscope.aliyuncs.com/compatible-mode/v1
#   US (Virginia):       https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Singapore:           https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Common models: qwen-plus, qwen-max, qwen-turbo, qwen3.6-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Active provider: deepseek | openai | anthropic | glm | qwen | mock
LLM_PROVIDER=mock

# Trace
TRACE_DIR=traces
